# Frontend dev runs on :4101 (next dev -p 4101); it talks to the backend API on
# :4100. Copy to .env.local to override. NEXT_PUBLIC_* values are inlined at
# build time — restart `next dev` after changing them.
NEXT_PUBLIC_AXON_API_BASE=http://localhost:4100

# Voice tuning (VAD + wake word) is served by the backend at GET /voice/config
# and configured there via AXON_VAD_* / AXON_WAKE_* — see the root .env.example.
