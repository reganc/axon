# Frontend dev runs on :4101 (next dev -p 4101). By default it derives the API
# base from the page's own host (so opening the app via localhost, a LAN IP, or
# Tailscale all "just work" against :4100 — no rebuild per host). Only set these
# to pin a fixed API endpoint (e.g. API on a different host/port). NEXT_PUBLIC_*
# values are inlined at build time — restart `next dev` after changing them.
# NEXT_PUBLIC_AXON_API_BASE=http://localhost:4100
# NEXT_PUBLIC_AXON_API_PORT=4100

# Voice tuning (VAD + wake word) is served by the backend at GET /voice/config
# and configured there via AXON_VAD_* / AXON_WAKE_* — see the root .env.example.
