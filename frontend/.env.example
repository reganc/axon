# Frontend dev runs on :4101 (next dev -p 4101); it talks to the backend API on
# :4100. Copy to .env.local to override. NEXT_PUBLIC_* values are inlined at
# build time — restart `next dev` after changing them.
NEXT_PUBLIC_AXON_API_BASE=http://localhost:4100

# ---- Voice tuning (all optional; defaults shown) ----
# Hands-free capture (RMS voice-activity detection): when does an armed mic stop?
NEXT_PUBLIC_AXON_VAD_SILENCE_MS=900        # stop after this much trailing silence
NEXT_PUBLIC_AXON_VAD_MAX_MS=12000          # hard cap on one capture
NEXT_PUBLIC_AXON_VAD_NO_SPEECH_MS=6000     # bail if nothing said after arming
NEXT_PUBLIC_AXON_VAD_RMS_THRESHOLD=0.015   # amplitude (0..1) that counts as speech
# Wake word ("Jarvis")
NEXT_PUBLIC_AXON_WAKE_COOLDOWN_MS=2500     # debounce: one "Jarvis" fires once
NEXT_PUBLIC_AXON_WAKE_RESTART_MS=300       # gap before restarting the recognizer
NEXT_PUBLIC_AXON_WAKE_PHRASE=jarvis|jervis|jarvus|jarviss|service  # accepted phrases
