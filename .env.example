# ---- Postgres (db service) ----
POSTGRES_USER=axon
POSTGRES_PASSWORD=change-me
POSTGRES_DB=axon

# ---- Host port mappings (4100 block — avoids the crowded 8000/8100/9000 ranges) ----
AXON_API_PORT=4100        # api + websocket  -> container 8100
AXON_FRONTEND_PORT=4101   # next.js frontend -> container 3000
AXON_DB_PORT=4102         # postgres         -> container 5432 (dev only)
AXON_REDIS_PORT=4103      # redis            -> container 6379 (dev only)
# 4104+ reserved.

# ---- AXON backend (prefix AXON_) ----
AXON_ENV=dev
AXON_DATABASE_URL=postgresql+asyncpg://axon:change-me@db:5432/axon
AXON_REDIS_URL=redis://cache:6379/0
# CORS: localhost:4101 + localhost:3000 are always allowed. To reach the app
# from other devices (LAN / Tailscale IP), set a regex of extra allowed origins.
# The frontend auto-derives its API host from the page URL, so this is all that's
# needed server-side. Leave empty for strict localhost-only.
# AXON_CORS_ORIGIN_REGEX=http://(localhost|127\.0\.0\.1|10\.\d{1,3}\.\d{1,3}\.\d{1,3}|192\.168\.\d{1,3}\.\d{1,3}|100\.\d{1,3}\.\d{1,3}\.\d{1,3}):4101

AXON_JWT_SECRET=change-me-dev-only

# inference — fast/local tier via the centralized llm-app gateway (OpenAI-compatible).
# All apps on this host share it; use the "default" alias, never a concrete model.
AXON_LLM_BASE_URL=http://host.docker.internal:8030/v1
AXON_LLM_API_KEY=change-me            # the gateway's Bearer token (llm-app API_KEY)
AXON_LLM_MODEL=default
# embeddings via the same box's Ollama (the gateway has no embeddings endpoint)
AXON_OLLAMA_BASE_URL=http://host.docker.internal:11434
AXON_OLLAMA_EMBED_MODEL=nomic-embed-text
# degrade fast when Ollama embeddings are wedged: short per-call timeout, then a
# circuit breaker that skips the primary after N consecutive failures (0 = off).
AXON_EMBED_TIMEOUT=5.0
AXON_EMBED_BREAKER_THRESHOLD=3
AXON_EMBED_BREAKER_COOLDOWN=60.0
# reason tier via Anthropic (off-box, opt-in)
AXON_ANTHROPIC_API_KEY=
AXON_ANTHROPIC_MODEL=claude-sonnet-4-6
AXON_EMBED_DIM=768

# cost-control model routing. Cheap/structuring work (extract/classify/curate/
# plan) -> model_cheap; research grounding -> model_ground; merge_judgment (which
# permanently shapes the canonical graph) and low-confidence escalation ->
# model_reason. Haiku is plenty for grounding; reserve Sonnet for merges.
# AXON_MODEL_REASON=claude-sonnet-4-6
# AXON_MODEL_CHEAP=claude-haiku-4-5
# AXON_MODEL_GROUND=claude-haiku-4-5
# How many nodes a turn generates+grounds in parallel (latency vs. load).
# AXON_COMPANION_GENERATE_CONCURRENCY=3
# Fast tier (node drafts + streamed narration/explanations). "local" = the shared
# 14B gateway (free, ~24s/draft); "cloud" = model_cheap (Haiku, ~2s, needs an
# Anthropic key). Budget breaker still degrades cloud fast-work to local.
# AXON_FAST_TIER=local

# canonicalization thresholds
AXON_CANON_MERGE_THRESHOLD=0.92
AXON_CANON_RELATED_THRESHOLD=0.80

# deep-dive cache — a reopened card narrates instantly from Redis instead of
# re-streaming the LLM; keyed on node content + level, so edits self-invalidate.
AXON_COMPANION_DIVE_CACHE_TTL_S=604800   # 7 days; 0 disables

# voice I/O — self-hosted, no external services (Piper TTS + faster-whisper STT).
# Models download once into the voice_models volume on first use.
AXON_VOICE_ENABLED=true
AXON_TTS_ENGINE=kokoro             # kokoro (natural prosody, default) | piper (fallback)
AXON_KOKORO_VOICE=bm_george        # British male ~ "Jarvis"; bm_lewis is the alternative
AXON_KOKORO_SPEED=1.0              # >1 faster, <1 slower
AXON_TTS_VOICE=en_GB-alan-medium   # piper fallback voice; any piper-voices id
AXON_TTS_LENGTH_SCALE=1.05         # speech pace: >1 slower/calmer, <1 faster (<0.9 slurs)
AXON_TTS_SENTENCE_SILENCE=0.25     # seconds of pause appended per sentence
AXON_STT_MODEL=base.en             # tiny.en | base.en | small.en
AXON_STT_DEVICE=cpu                # cpu | cuda (cuda contends with Ollama's GPU)
AXON_STT_COMPUTE_TYPE=int8         # int8 (cpu) | float16 (cuda)
# client-side voice tuning — served to the frontend via GET /voice/config
AXON_VAD_SILENCE_MS=900            # stop capture after this much trailing silence
AXON_VAD_MAX_MS=12000             # hard cap on one hands-free capture
AXON_VAD_NO_SPEECH_MS=6000        # bail if nothing said after arming
AXON_VAD_RMS_THRESHOLD=0.015      # amplitude (0..1) that counts as speech
AXON_WAKE_COOLDOWN_MS=2500        # debounce: one "Jarvis" fires once
AXON_WAKE_RESTART_MS=300          # gap before restarting the recognizer
AXON_WAKE_PHRASE=jarvis|jervis|jarvus|jarviss|service  # accepted wake phrases
